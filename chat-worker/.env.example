# Phyllis Home Care Chat Worker - Environment Variables
# Copy this file to .env.local for development or configure in Cloudflare Workers dashboard

# Required: OpenAI API Key for chat functionality
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-api-key-here

# Required: Comma-separated list of allowed origins for CORS
# Production example: https://phyllishomecare.com,https://www.phyllishomecare.com
# Development: http://localhost:3000,http://127.0.0.1:3000
# IMPORTANT: If not set, only localhost will be allowed (development mode)
ALLOWED_ORIGINS=https://phyllishomecare.com,https://www.phyllishomecare.com

# Optional: OpenAI model to use (default: gpt-4o-mini)
# Other options: gpt-4, gpt-4-turbo, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini

# Note: Rate limiting is currently per-worker instance (in-memory)
# For production with thousands of concurrent users, consider:
# 1. Cloudflare Rate Limiting (https://developers.cloudflare.com/waf/rate-limiting-rules/)
# 2. Cloudflare Turnstile (https://developers.cloudflare.com/turnstile/)
# 3. Durable Objects for distributed rate limiting
